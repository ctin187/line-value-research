# ---------------------------------------------------------------------------
# Copy to .env and fill in your key:  cp .env.example .env
# Without ODDS_API_KEY the app still runs, on a simulated feed (demo mode).
# ---------------------------------------------------------------------------

# Free key from https://the-odds-api.com (500 credits/month on the free tier).
ODDS_API_KEY=

# --- server -----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1

# --- what to scan -----------------------------------------------------------
# Books to pull. Pinnacle is the sharp reference the fair-price engine leans on;
# drop it and edges fall back to a plain consensus of the public books.
BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us,pinnacle
ODDS_REGIONS=us
ODDS_MARKETS=spreads,totals,h2h
LOOKAHEAD_DAYS=7

# --- refresh + quota --------------------------------------------------------
# UI_REFRESH_MS is how often the browser re-reads the server's cached board.
# It costs nothing.
UI_REFRESH_MS=60000
#
# FETCH_INTERVAL_MS is how often the server may call The Odds API. One call
# costs (markets x regions) credits -- 3 with the defaults above -- per sport.
# At the 5-minute default, scanning both sports costs ~864 credits/day, so on
# the free tier run the app only while you are actually using it, or raise this.
# A literal 60s upstream poll would spend a whole free month in about 2 hours.
FETCH_INTERVAL_MS=300000
#
# Hard stops. The scanner refuses to call upstream past either of these.
QUOTA_FLOOR=20
DAILY_CALL_CAP=200

# --- value thresholds -------------------------------------------------------
HIGH_EDGE_PCT=2
MODERATE_EDGE_PCT=1
LINE_MOVE_POINTS=0.5
DIVERGENCE_POINTS=0.5
DIVERGENCE_CENTS=15
#
# Inflated-favourite test: BOTH must hold. Note -120 on its own implies only
# 54.5%, so with a 0.7 probability floor the flag effectively fires at about
# -234 and shorter. Set INFLATED_FAV_PROB=0.545 to flag every favourite from
# -120 down instead.
INFLATED_FAV_PRICE=-120
INFLATED_FAV_PROB=0.7

# --- bankroll / staking -----------------------------------------------------
BANKROLL=1000
KELLY_MULTIPLIER=0.25
MAX_RISK_SOFT_PCT=0.02
MAX_RISK_HARD_PCT=0.05

# --- misc -------------------------------------------------------------------
# multiplicative (default, proportional) or additive
DEVIG_METHOD=multiplicative
HISTORY_FILE=./data/history.json
HISTORY_DEPTH=60
ALERT_DEPTH=200

# Force the simulated feed even when a key is present.
DEMO_MODE=0
